@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> signInManager
@inject UserManager<IdentityUser> userManager

@model Blog.Web.Models.ViewModels.BlogDetailsViewModel

@{
    ViewData["Title"] = Model?.PageTitle;
}

<div class="row">
    <div class="container my-8">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">

                @if (Model != null)
                {
                    <h1 class="mb-3">@Model.Heading</h1>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-secondary">@Model.Author</span>
                        <span class="text-secondary">
                            @Model.PublishedDate.ToShortDateString()
                        </span>
                    </div>

                    <div class="mb-3 d-flex">
                        @foreach (var tag in Model.Tags)
                        {
                            <span class="badge bg-secondary me-1">@tag.Name</span>
                        }
                    </div>

                    <div class="mb-3">
                        @if (signInManager.IsSignedIn(User))
                        {
                            if (Model.Liked)
                            {
                                <a style="cursor: pointer;">
                                    <i class="bi bi-hand-thumbs-up-fill"></i>
                                </a>
                            }
                            else
                            {
                                <a id="btnLike" style="cursor: pointer;">
                                    <i class="bi bi-hand-thumbs-up"></i>
                                </a>
                            }
                        }

                        <span id="totalLikes">@Model.TotalLikes</span> likes
                    </div>

                    <img src="@Model.FeaturedImageURL"
                         class="d-block img-fluid mb-3"
                         alt="@Model.Heading" />

                    <div class="mb-3 blog-details-content">
                        @Html.Raw(Model.Content)
                    </div>

                    <section class="comments-panel mt-5" id="comments" aria-labelledby="comments-heading">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <p class="comments-eyebrow mb-1">COMMUNITY</p>
                                <h2 class="h4 mb-0" id="comments-heading">Join the discussion</h2>
                            </div>
                            <span class="comments-count">@(Model.Comments?.Count() ?? 0) comments</span>
                        </div>

                        @if (signInManager.IsSignedIn(User))
                        {
                            <form method="post" asp-controller="Blog" asp-action="BlogsDetails" class="comment-composer mb-4">
                                <div class="mb-3">
                                    <label asp-for="CommentDescription" class="form-label fw-semibold">Leave a comment</label>
                                    <textarea asp-for="CommentDescription" class="form-control comment-input" rows="3" maxlength="2000" placeholder="What did you think about this post?" required></textarea>
                                    <div class="form-text">Keep it kind and constructive.</div>
                                    <input type="hidden" asp-for="Id" />
                                    <input type="hidden" asp-for="URLHandle" />
                                </div>

                                <button type="submit" class="btn btn-dark px-4">
                                    <i class="bi bi-send me-2" aria-hidden="true"></i>Post comment
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="comment-login-prompt mb-4">
                                <span>Sign in to share your thoughts.</span>
                                <a class="btn btn-outline-dark btn-sm" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Sign in</a>
                            </div>
                        }

                        <div class="comments-list">
                           @if (Model.Comments != null && Model.Comments.Any())
                            {
                                @foreach(var comment in Model.Comments)
                                {
                                    <article class="comment-item">
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <span class="comment-avatar" aria-hidden="true">
                                                    @((string.IsNullOrWhiteSpace(comment.Username) ? "U" : comment.Username[..1]).ToUpperInvariant())
                                                </span>
                                                <span class="text-dark fw-semibold">@(string.IsNullOrWhiteSpace(comment.Username) ? "User" : comment.Username)</span>
                                                <span class="text-secondary small">·</span>
                                                <time class="small text-secondary" datetime="@comment.DateAdded.ToString("o")">@comment.DateAdded.ToString("MMM d, yyyy · h:mm tt")</time>
                                            </div>
                                            <div class="comment-text">
                                                @comment.Description
                                            </div>
                                    </article>
                                }
                            }
                            else
                            {
                                <div class="comments-empty">
                                    <i class="bi bi-chat-square-text" aria-hidden="true"></i>
                                    <p class="fw-semibold mb-1">No comments yet</p>
                                    <p class="text-secondary mb-0">Start the conversation with a thoughtful comment.</p>
                                </div>
                            }
                        </div>
                    </section>
                }
                else
                {
                    <p>Blog post not found.</p>
                }

            </div>
        </div>
    </div>
</div>
@section Scripts {
    @if (Model != null)
    {
        <script>
            const btnLikeElement = document.getElementById('btnLike');
            const totalLikesElement = document.getElementById('totalLikes');

            let likeRequestInProgress = false;

            async function getTotalLikes() {
                const response = await fetch(
                    '/api/BlogPostLike/@Model.Id/totalLikes',
                    {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error(
                        `Total likes fetch failed: ${response.status}`
                    );
                }

                const result = await response.json();
                totalLikesElement.textContent = result;
            }

            async function addLikeForBlog(event) {
                event.preventDefault();

                if (likeRequestInProgress) {
                    return;
                }

                likeRequestInProgress = true;

                try {
                    const response = await fetch('/api/BlogPostLike/Add', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': '*/*'
                        },
                        body: JSON.stringify({
                            blogPostId: '@Model.Id',
                            userId: '@userManager.GetUserId(User)'
                        })
                    });

                    if (!response.ok) {
                        throw new Error(
                            `Like request failed: ${response.status}`
                        );
                    }

                    btnLikeElement.innerHTML =
                        '<i class="bi bi-hand-thumbs-up-fill"></i>';

                    btnLikeElement.removeEventListener(
                        'click',
                        addLikeForBlog
                    );

                    btnLikeElement.style.cursor = 'default';

                    try {
                        await getTotalLikes();
                    } catch (error) {
                        console.error(
                            'Like saved, but count refresh failed:',
                            error
                        );
                    }
                } catch (error) {
                    console.error('Error adding like:', error);
                } finally {
                    likeRequestInProgress = false;
                }
            }

            if (btnLikeElement) {
                btnLikeElement.addEventListener(
                    'click',
                    addLikeForBlog
                );
            }
        </script>
    }
}
