@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> signInManager
@inject UserManager<IdentityUser> userManager

@model Blog.Web.Models.ViewModels.BlogDetailsViewModel

@{
    ViewData["Title"] = Model?.PageTitle;
}

<div class="row">
    <div class="container my-8">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-6">

                @if (Model != null)
                {
                    <h1 class="mb-3">@Model.Heading</h1>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-secondary">@Model.Author</span>
                        <span class="text-secondary">
                            @Model.PublishedDate.ToShortDateString()
                        </span>
                    </div>

                    <div class="mb-3 d-flex">
                        @foreach (var tag in Model.Tags)
                        {
                            <span class="badge bg-secondary me-1">@tag.Name</span>
                        }
                    </div>

                    <div class="mb-3">
                        @if (signInManager.IsSignedIn(User))
                        {
                            if (Model.Liked)
                            {
                                <a style="cursor: pointer;">
                                    <i class="bi bi-hand-thumbs-up-fill"></i>
                                </a>
                            }
                            else
                            {
                                <a id="btnLike" style="cursor: pointer;">
                                    <i class="bi bi-hand-thumbs-up"></i>
                                </a>
                            }
                        }

                        <span id="totalLikes">@Model.TotalLikes</span> likes
                    </div>

                    <img src="@Model.FeaturedImageURL"
                         class="d-block img-fluid mb-3"
                         alt="@Model.Heading" />

                    <div class="mb-3 blog-details-content">
                        @Html.Raw(Model.Content)
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h5>Comments</h5>
                        </div>

                        @if (signInManager.IsSignedIn(User))
                        {
                            <form method="post" asp-controller="Blog" asp-action="BlogsDetails">
                                <div class="mb-3">
                                    <textarea asp-for="CommentDescription" class="form-control"></textarea>
                                    <input type="hidden" asp-for="Id" />
                                    <input type="hidden" asp-for="URLHandle" />
                                </div>

                                <div class="mb-3">
                                    <button type="submit" class="btn btn-dark">
                                        Submit
                                    </button>
                                </div>
                            </form>
                        }

                        <div class="card-body">
                            <!-- Comments go here -->
                        </div>
                    </div>
                }
                else
                {
                    <p>Blog post not found.</p>
                }

            </div>
        </div>
    </div>
</div>
@section Scripts {
    @if (Model != null)
    {
        <script>
            const btnLikeElement = document.getElementById('btnLike');
            const totalLikesElement = document.getElementById('totalLikes');

            let likeRequestInProgress = false;

            async function getTotalLikes() {
                const response = await fetch(
                    '/api/BlogPostLike/@Model.Id/totalLikes',
                    {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error(
                        `Total likes fetch failed: ${response.status}`
                    );
                }

                const result = await response.json();
                totalLikesElement.textContent = result;
            }

            async function addLikeForBlog(event) {
                event.preventDefault();

                if (likeRequestInProgress) {
                    return;
                }

                likeRequestInProgress = true;

                try {
                    const response = await fetch('/api/BlogPostLike/Add', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': '*/*'
                        },
                        body: JSON.stringify({
                            blogPostId: '@Model.Id',
                            userId: '@userManager.GetUserId(User)'
                        })
                    });

                    if (!response.ok) {
                        throw new Error(
                            `Like request failed: ${response.status}`
                        );
                    }

                    btnLikeElement.innerHTML =
                        '<i class="bi bi-hand-thumbs-up-fill"></i>';

                    btnLikeElement.removeEventListener(
                        'click',
                        addLikeForBlog
                    );

                    btnLikeElement.style.cursor = 'default';

                    try {
                        await getTotalLikes();
                    } catch (error) {
                        console.error(
                            'Like saved, but count refresh failed:',
                            error
                        );
                    }
                } catch (error) {
                    console.error('Error adding like:', error);
                } finally {
                    likeRequestInProgress = false;
                }
            }

            if (btnLikeElement) {
                btnLikeElement.addEventListener(
                    'click',
                    addLikeForBlog
                );
            }
        </script>
    }
}
